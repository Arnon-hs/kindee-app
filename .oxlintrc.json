{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn", "oxc"],
  "categories": {"correctness": "warn"},
  "rules": {
    "typescript/no-explicit-any": "warn",
    "typescript/no-non-null-assertion": "warn",
    "no-nested-ternary": "warn",
    "no-useless-assignment": "warn",
    "no-eval": "warn",
    "no-unreachable": "warn",
    "no-constant-condition": "warn"
  },
  // Scope is the maintained web client/config/scripts, not Swift/Kotlin or vendored JS.
  "ignorePatterns": ["native/**", "android/**", "ios/**", "dist/**", "reports/**"],
  // Step 2 adds native assertion/conditional warnings; old files remain report-only.
  // The broad probe's SonarJS formatting and inferred-boundary-type noise is not adopted.
  // SonarJS's template-only unused variables would be false positives in Vue; native
  // no-unused-vars/no-useless-assignment see template references, so no Vue override is needed.
  // SonarJS password/regex rules are not enabled: the probe matched a localization key
  // and bounded repository-translation tests. Do not exempt application code from native rules.
  // SonarJS 4.2.2 was not retained: its packaged LICENSE differs from npm's LGPL metadata.
  "overrides": [
    {
      // Authentication mixes transport and error-priority branches. Keep its path
      // budget small; this is cyclomatic complexity, not Sonar cognitive complexity.
      "files": ["src/api/auth.ts"],
      "rules": {"complexity": ["warn", {"max": 8}]}
    }
  ]
}
