        }
      }
    },
    "No saved meals for this day. Build a mixed plan with cooking, cafes and delivery.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этот день плана нет. Выберите блюда из готовки, кафе и доставки."
          }
        }
      }
    },
    "Couldn't load your saved plan. Open Plan to try again.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "План не загрузился. Откройте его и повторите попытку."
