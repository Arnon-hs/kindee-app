        }
      }
    },
    "Connect Kindee to see your saved meals here. Your diary works independently.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите Kindee, чтобы видеть блюда из плана. Дневник уже работает."
