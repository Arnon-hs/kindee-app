{
  "path": [
    "src"
  ],
  "format": [
    "typescript",
    "javascript",
    "vue"
  ],
  "ignore": [
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.d.ts",
    "**/fixtures/**",
    "**/generated/**",
    "**/__generated__/**"
  ],
  "minLines": 6,
  "minTokens": 40,
  "threshold": 0,
  "failOnEmpty": true,
  "reporters": [
    "console"
  ]
}
